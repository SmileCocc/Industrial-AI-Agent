# ===== 模型配置（OpenAI 兼容接口）=====
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT=60

# ===== Agent 限制 =====
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT=120

# ===== MySQL（三个服务各用独立库）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
ERP_DB_NAME=industrial_erp
MES_DB_NAME=industrial_mes
AGENT_DB_NAME=industrial_agent

# ===== 服务地址与服务间调用 =====
ERP_BASE_URL=http://127.0.0.1:8001
MES_BASE_URL=http://127.0.0.1:8002
# 服务间令牌，非空时 ERP/MES 校验请求头 X-Service-Token
SERVICE_TOKEN=
HTTP_TIMEOUT=10

LOG_LEVEL=INFO
